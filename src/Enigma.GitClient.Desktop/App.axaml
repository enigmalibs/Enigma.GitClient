<!--
  Dark is the starting variant, not "Default". Enigma.Avalonia.Desktop's dictionary defines
  Dark and Light theme dictionaries only, so on a host whose platform theme cannot be resolved
  "Default" leaves every Enigma* brush unresolved and the window paints almost nothing.
  Following the operating system is offered as a setting instead.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Enigma.GitClient.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Enigma.GitClient.Desktop/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Enigma.Avalonia.Desktop is a ResourceDictionary, so it must be a ResourceInclude here
             and not a StyleInclude. Our own themes are merged after it, so an override of an
             Enigma* key would win. -->
        <ResourceInclude Source="avares://Enigma.Avalonia.Desktop/Themes/Fluent.axaml" />
        <ResourceInclude Source="avares://Enigma.GitClient.Desktop/Themes/Graph.axaml" />
        <ResourceInclude Source="avares://Enigma.GitClient.Desktop/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- One monospace stack for short hashes and file content, listing a face that exists on
           Linux and one that exists on Windows before falling back to the generic family. -->
      <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, Consolas, Menlo, monospace</FontFamily>

      <!-- The navigation rail's width in each window: the narrowest multiple of 4 that leaves the
           window's longest label at least 2 of room to spare, which is what layout rounding at a
           fractional scale can take away. The library's item wraps a label that does not fit
           mid-word, and puts 21 around it: 8 of padding and two 1 margins on each side, and the
           rail's 1 border. So the repository window, whose longest labels are "Changes" and
           "Conflicts" (46 in Inter 11), is 72; the start window, whose "Repositories" is 64.4, is 88.
           One width for both would be pinned at 88 by a label the repository window never shows. -->
      <x:Double x:Key="RepositoryRailWidth">72</x:Double>
      <x:Double x:Key="StartRailWidth">88</x:Double>
    </ResourceDictionary>
  </Application.Resources>
</Application>
