<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.Desktop.Controls"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Panels"
             x:Class="Enigma.GitClient.Desktop.Views.Panels.ChangedFilesPanelView"
             x:DataType="vm:ChangedFilesPanelViewModel">

  <UserControl.Resources>
    <!-- One template, used by both shapes: the list and the tree must never disagree about what a
         row looks like or what is selected. -->
    <DataTemplate x:Key="ChangedFileRow" x:DataType="vm:ChangedFileNodeViewModel">
      <!-- The name sits in the one star column so the Grid can shrink it and the trimming
           actually fires. A horizontal StackPanel would measure every child with infinite width,
           which is what made a deeply indented tree row run past the panel's edge. The line's
           shape — its height, spacing and brush — is the shared listrow (Themes/Styles.axaml),
           which the branches, tags and remotes are drawn with too. -->
      <Grid Classes="listrow" ColumnDefinitions="Auto,*,Auto,Auto,Auto">

        <!-- The row's own menu. A ContextMenu opens in its own popup tree, so it cannot reach the
             panel through a visual ancestor: the row passes the panel's commands through instead,
             which keeps the binding a plain one against the row itself. -->
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding Actions.PrimaryLabel}"
                      IsVisible="{Binding HasActions}"
                      Command="{Binding Actions.Primary}"
                      CommandParameter="{Binding}">
              <MenuItem.Icon>
                <ei:Icon Kind="{Binding Actions.PrimaryIcon}" Classes="menu" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding Actions.SecondaryLabel}"
                      IsVisible="{Binding HasSecondaryAction}"
                      Command="{Binding Actions.Secondary}"
                      CommandParameter="{Binding}">
              <MenuItem.Icon>
                <ei:Icon Kind="{Binding Actions.SecondaryIcon}" Classes="menu" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator IsVisible="{Binding HasActions}" />
            <MenuItem Header="Open file"
                      Command="{Binding OpenFileCommand}"
                      CommandParameter="{Binding}">
              <MenuItem.Icon>
                <ei:Icon Kind="FileText" Classes="menu" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in file manager"
                      Command="{Binding RevealFileCommand}"
                      CommandParameter="{Binding}">
              <MenuItem.Icon>
                <ei:Icon Kind="FolderOpen" Classes="menu" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding HostLinkLabel}"
                      IsVisible="{Binding HasHostLink}"
                      Command="{Binding OpenOnHostCommand}"
                      CommandParameter="{Binding}">
              <MenuItem.Icon>
                <ei:Icon Kind="ArrowSquareOut" Classes="menu" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copy path"
                      Command="{Binding CopyPathCommand}"
                      CommandParameter="{Binding}">
              <MenuItem.Icon>
                <ei:Icon Kind="Copy" Classes="menu" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy file name"
                      Command="{Binding CopyNameCommand}"
                      CommandParameter="{Binding}">
              <MenuItem.Icon>
                <ei:Icon Kind="Copy" Classes="menu" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>

        <!-- Avalonia can bind a style class straight to a boolean, which is far clearer than a
             converter that compares strings. -->
        <Border Grid.Column="0"
                Classes="status"
                Classes.added="{Binding IsAdded}"
                Classes.deleted="{Binding IsDeleted}"
                Classes.renamed="{Binding IsMoved}"
                Classes.conflicted="{Binding IsConflicted}"
                IsVisible="{Binding !IsDirectory}">
          <TextBlock Text="{Binding StatusGlyph}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <ei:Icon Grid.Column="0"
                 Kind="Folder"
                 Classes="row dim"
                 VerticalAlignment="Center"
                 IsVisible="{Binding IsDirectory}" />

        <TextBlock Grid.Column="1"
                   Classes="rowname"
                   Text="{Binding Label}"
                   ToolTip.Tip="{Binding Path}" />

        <TextBlock Grid.Column="2"
                   Classes="rowdetail faint"
                   Text="{Binding RenameLabel}"
                   IsVisible="{Binding IsRenamed}"
                   ToolTip.Tip="{Binding RenameSource}"
                   MaxWidth="150"
                   TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="3"
                Classes="toolbar rowaction"
                IsVisible="{Binding HasActions}"
                Command="{Binding Actions.Primary}"
                CommandParameter="{Binding}"
                ToolTip.Tip="{Binding Actions.PrimaryLabel}"
                AutomationProperties.Name="{Binding Actions.PrimaryLabel}">
          <ei:Icon Kind="{Binding Actions.PrimaryIcon}" Classes="row" />
        </Button>

        <TextBlock Grid.Column="4"
                   Classes="rowdetail faint"
                   Text="{Binding LineCounts}"
                   IsVisible="{Binding !IsDirectory}" />

        <TextBlock Grid.Column="4"
                   Classes="rowdetail faint"
                   Text="{Binding DirectorySummary}"
                   IsVisible="{Binding IsDirectory}" />

      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="{Binding Summary}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <!-- The tree's own: a list has no folders to open or close. -->
          <Button Name="ExpandAll"
                  Classes="toolbar"
                  IsVisible="{Binding IsTreeMode}"
                  Command="{Binding ExpandAllCommand}"
                  ToolTip.Tip="Expand all folders"
                  AutomationProperties.Name="Expand all folders">
            <ei:Icon Kind="CaretDoubleDown" Classes="toolbar" />
          </Button>
          <Button Name="CollapseAll"
                  Classes="toolbar"
                  IsVisible="{Binding IsTreeMode}"
                  Command="{Binding CollapseAllCommand}"
                  ToolTip.Tip="Collapse all folders"
                  AutomationProperties.Name="Collapse all folders">
            <ei:Icon Kind="CaretDoubleUp" Classes="toolbar" />
          </Button>
          <Border Width="1"
                  Margin="4,2"
                  IsVisible="{Binding IsTreeMode}"
                  Background="{DynamicResource EnigmaBorderSubtleBrush}" />

          <ToggleButton Classes="segment"
                        IsChecked="{Binding IsListMode, Mode=OneWay}"
                        Command="{Binding ShowAsListCommand}"
                        ToolTip.Tip="Show the files as a flat list"
                        AutomationProperties.Name="Show the files as a flat list">
            <ei:Icon Kind="ListBullets" Classes="toolbar" />
          </ToggleButton>
          <ToggleButton Classes="segment"
                        IsChecked="{Binding IsTreeMode, Mode=OneWay}"
                        Command="{Binding ShowAsTreeCommand}"
                        ToolTip.Tip="Show the files as a tree"
                        AutomationProperties.Name="Show the files as a tree">
            <ei:Icon Kind="TreeStructure" Classes="toolbar" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="10,6,10,4">
      <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Filter files"
               FontSize="12"
               AutomationProperties.Name="Filter the changed files" />
    </Border>

    <!-- The three share one cell rather than docking beside one another: a docked child claims a
         slice of the panel's width, which left the empty state squeezed against the edge instead
         of centred over the space the list would have used. -->
    <Grid>

      <controls:EmptyState IconKind="FileText"
                           Title="{Binding EmptyTitle}"
                           Message="{Binding EmptyMessage}"
                           IsVisible="{Binding IsEmpty}" />

      <!-- Each control binds its own view of the selection, which it is handed only while it is the
           one shown: the hidden one would otherwise write its own "nothing" over the other's choice. -->
      <ListBox Classes="rows"
               ItemsSource="{Binding Nodes}"
               SelectedItem="{Binding ListSelection, Mode=TwoWay}"
               ItemTemplate="{StaticResource ChangedFileRow}"
               IsVisible="{Binding IsListMode}"
               AutomationProperties.Name="Changed files" />

      <TreeView Name="FilesTree"
                Classes="rows"
                ItemsSource="{Binding Nodes}"
                SelectedItem="{Binding TreeSelection, Mode=TwoWay}"
                IsVisible="{Binding IsTreeMode}"
                AutomationProperties.Name="Changed files">
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:ChangedFileNodeViewModel" ItemsSource="{Binding Children}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChangedFileRow}" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
        <TreeView.Styles>
          <!-- The item's own DataContext is the node, so the selector's x:DataType has to say so:
               without it the compiled binding resolves against the panel's ViewModel instead. -->
          <Style Selector="TreeViewItem" x:DataType="vm:ChangedFileNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
      </TreeView>
    </Grid>
  </DockPanel>
</UserControl>
