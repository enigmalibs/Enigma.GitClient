<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.Desktop.Controls"
             xmlns:diff="using:Enigma.GitClient.Desktop.Controls.Diff"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Panels"
             x:Class="Enigma.GitClient.Desktop.Views.Panels.DiffViewerView"
             x:DataType="vm:DiffViewerViewModel">

  <!-- The diff is read-only: its text can be selected and copied, never typed into. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
  </UserControl.KeyBindings>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">

        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="320"
                   Foreground="{DynamicResource EnigmaForegroundBrush}" />

        <TextBlock Grid.Column="1"
                   Text="{Binding Subtitle}"
                   IsVisible="{Binding HasSubtitle}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="200"
                   Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

        <TextBlock Grid.Column="2"
                   Text="{Binding Summary}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">

          <ToggleButton Classes="segment"
                        IsChecked="{Binding IsUnified, Mode=OneWay}"
                        Command="{Binding ShowUnifiedCommand}"
                        ToolTip.Tip="Unified"
                        AutomationProperties.Name="Unified">
            <ei:Icon Kind="Rows" Classes="toolbar" />
          </ToggleButton>

          <ToggleButton Classes="segment"
                        IsChecked="{Binding IsSideBySide, Mode=OneWay}"
                        Command="{Binding ShowSideBySideCommand}"
                        ToolTip.Tip="Side by side"
                        AutomationProperties.Name="Side by side">
            <ei:Icon Kind="Columns" Classes="toolbar" />
          </ToggleButton>

          <Border Width="1"
                  Margin="4,2"
                  Background="{DynamicResource EnigmaBorderSubtleBrush}" />

          <ToggleButton Classes="segment"
                        IsChecked="{Binding Render.ShowWhitespace, Mode=TwoWay}"
                        ToolTip.Tip="Show spaces and tabs"
                        AutomationProperties.Name="Show spaces and tabs">
            <ei:Icon Kind="DotsSixVertical" Classes="toolbar" />
          </ToggleButton>

          <!-- Unified only: the two sides of the side-by-side rendering are two editors, and two
               editors wrapping independently would put the rows out of line. -->
          <ToggleButton Classes="segment"
                        IsChecked="{Binding Render.WrapLines, Mode=TwoWay}"
                        IsEnabled="{Binding IsUnified}"
                        ToolTip.Tip="Wrap long lines (unified view)"
                        ToolTip.ShowOnDisabled="True"
                        AutomationProperties.Name="Wrap long lines">
            <ei:Icon Kind="TextAlignLeft" Classes="toolbar" />
          </ToggleButton>

          <ToggleButton Classes="segment"
                        IsChecked="{Binding IgnoreAllWhitespace, Mode=TwoWay}"
                        ToolTip.Tip="Ignore whitespace changes"
                        AutomationProperties.Name="Ignore whitespace changes">
            <ei:Icon Kind="Eraser" Classes="toolbar" />
          </ToggleButton>

          <Border Width="1"
                  Margin="4,2"
                  Background="{DynamicResource EnigmaBorderSubtleBrush}" />

          <Button Classes="toolbar"
                  Command="{Binding ExpandContextCommand}"
                  ToolTip.Tip="Show more surrounding lines"
                  AutomationProperties.Name="Show more surrounding lines">
            <ei:Icon Kind="ArrowsOutLineVertical" Classes="toolbar" />
          </Button>

          <Button Classes="toolbar"
                  Command="{Binding CopyPatchCommand}"
                  ToolTip.Tip="Copy the whole patch"
                  AutomationProperties.Name="Copy the whole patch">
            <ei:Icon Kind="Copy" Classes="toolbar" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding IsTruncated}"
            Background="{DynamicResource DiffHunkBandBrush}"
            Padding="10,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="This file is very large, so only the first part of its diff was read."
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
        <Button Grid.Column="1"
                Content="Show anyway"
                Command="{Binding ShowAnywayCommand}" />
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="GitDiff"
                           Title="Diff"
                           Message="{Binding Message}"
                           IsVisible="{Binding HasMessage}" />

      <!--
        The unified rendering is one read-only editor and the map of its changes beside it. The
        editor's vertical bar is Hidden rather than Disabled: the map replaces the bar, not the
        scrolling, so the wheel, the keyboard and the selection still move the text. Its horizontal
        bar is its own, and moves the text alone — the gutter is a margin, outside the scrolling.
      -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsUnified}">

        <diff:DiffTextEditor Grid.Column="0"
                             Name="UnifiedEditor"
                             Rows="{Binding UnifiedRows}"
                             Pane="Unified"
                             FilePath="{Binding Title}"
                             ShowWhitespace="{Binding Render.ShowWhitespace}"
                             TabWidth="{Binding Render.TabWidth}"
                             WordWrap="{Binding Render.WrapLines}"
                             TextSelection="{Binding Render.Selection}"
                             CopyCommand="{Binding CopyCommand}"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Hidden"
                             AutomationProperties.Name="Unified diff">
          <diff:DiffTextEditor.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C">
                <MenuItem.Icon>
                  <ei:Icon Kind="Copy" Classes="menu" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </diff:DiffTextEditor.ContextMenu>
        </diff:DiffTextEditor>

        <diff:DiffMinimap Grid.Column="1"
                          Name="UnifiedMinimap"
                          IsVisible="{Binding HasPatch}"
                          Marks="{Binding UnifiedMap}"
                          RowCount="{Binding UnifiedRows.Count}"
                          AutomationProperties.Name="Where the changes are in this file" />
      </Grid>

      <!--
        The side-by-side rendering is two read-only editors either side of the divider — the old file
        and the new, kept level by the filler lines the projection inserted — and the map beside them.
        A DiffScrollLink keeps the two scrolled together, down and sideways; the map follows the left
        one and drives it, and the right one follows. Neither wraps: two editors wrap independently.
      -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSideBySide}">

        <Grid Grid.Column="0" ColumnDefinitions="*,1,*">

          <diff:DiffTextEditor Grid.Column="0"
                               Name="LeftEditor"
                               Rows="{Binding SideBySideRows}"
                               Pane="Left"
                               FilePath="{Binding Title}"
                               ShowWhitespace="{Binding Render.ShowWhitespace}"
                               TabWidth="{Binding Render.TabWidth}"
                               WordWrap="False"
                               TextSelection="{Binding Render.Selection}"
                               CopyCommand="{Binding CopyCommand}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Hidden"
                               AutomationProperties.Name="The file before the change">
            <diff:DiffTextEditor.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C">
                  <MenuItem.Icon>
                    <ei:Icon Kind="Copy" Classes="menu" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </diff:DiffTextEditor.ContextMenu>
          </diff:DiffTextEditor>

          <Border Grid.Column="1" Background="{DynamicResource EnigmaBorderSubtleBrush}" />

          <diff:DiffTextEditor Grid.Column="2"
                               Name="RightEditor"
                               Rows="{Binding SideBySideRows}"
                               Pane="Right"
                               FilePath="{Binding Title}"
                               ShowWhitespace="{Binding Render.ShowWhitespace}"
                               TabWidth="{Binding Render.TabWidth}"
                               WordWrap="False"
                               TextSelection="{Binding Render.Selection}"
                               CopyCommand="{Binding CopyCommand}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Hidden"
                               AutomationProperties.Name="The file after the change">
            <diff:DiffTextEditor.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C">
                  <MenuItem.Icon>
                    <ei:Icon Kind="Copy" Classes="menu" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </diff:DiffTextEditor.ContextMenu>
          </diff:DiffTextEditor>
        </Grid>

        <diff:DiffMinimap Grid.Column="1"
                          Name="SideBySideMinimap"
                          IsVisible="{Binding HasPatch}"
                          Marks="{Binding SideBySideMap}"
                          RowCount="{Binding SideBySideRows.Count}"
                          AutomationProperties.Name="Where the changes are in this file" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
