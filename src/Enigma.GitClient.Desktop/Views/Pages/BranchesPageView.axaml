<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.Desktop.Controls"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Pages"
             x:Class="Enigma.GitClient.Desktop.Views.Pages.BranchesPageView"
             x:DataType="vm:BranchesPageViewModel">

  <!--
    The branches page: the header, the manual merge, and a tree of compact lines drawn like the
    changed files beside the history. "Local" first, then one node per remote; every "/" segment of a
    branch's name is a folder. A branch's line is its last name segment and its badges, where a file's
    line has its line counts; the rest is in its tooltip, and everything that can be done to it is in
    its menu, or a drag onto another branch.
  -->

  <UserControl.Styles>
    <!-- Where a dragged branch would land. A ring rather than a fill: the line underneath may be the
         selected one or the hovered one, and a drop mark has to be legible over both. -->
    <Style Selector="TreeViewItem.droptarget">
      <Setter Property="BorderBrush" Value="{DynamicResource ActionAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- A badge: a few faint words, with an icon when it has one, in the right-hand column where a
         changed file has its line counts. -->
    <Style Selector="StackPanel.badge">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>


  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <ei:Icon Kind="GitBranch" Classes="header" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          <TextBlock Text="{Binding Title}"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </StackPanel>

        <TextBox Grid.Column="1"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 MaxWidth="320"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 AutomationProperties.Name="Filter branches" />

        <!-- The order of the lines within each group: by name or by date, and which way. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Sort by"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Classes="dim" />
          <ComboBox Name="SortKey"
                    ItemsSource="{Binding SortKeys}"
                    SelectedItem="{Binding SortKey, Mode=TwoWay}"
                    MinWidth="90"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sort the branches by" />
          <Button Name="SortDirection"
                  Classes="toolbar"
                  Command="{Binding ToggleSortDirectionCommand}"
                  ToolTip.Tip="{Binding SortDirectionTip}"
                  AutomationProperties.Name="{Binding SortDirectionTip}">
            <Panel>
              <ei:Icon Kind="SortAscending" Classes="toolbar" IsVisible="{Binding !IsSortDescending}" />
              <ei:Icon Kind="SortDescending" Classes="toolbar" IsVisible="{Binding IsSortDescending}" />
            </Panel>
          </Button>
        </StackPanel>

        <!-- The selected branches, deleted after one question: red while there is any to delete, as
             every button that loses something is. The Delete key on the tree does the same. -->
        <Button Grid.Column="3"
                Name="DeleteSelection"
                Classes="toolbar danger"
                Command="{Binding DeleteSelectionCommand}"
                ToolTip.Tip="Delete the selected branches"
                AutomationProperties.Name="Delete the selected branches">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Trash" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DeleteSelectionLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="4"
                Classes="toolbar"
                Command="{Binding CreateBranchCommand}"
                ToolTip.Tip="Create a branch"
                AutomationProperties.Name="Create a branch">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="New branch" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!--
      The manual merge: another way to say "merge this into that" than dropping one row on another,
      for when the two branches are far apart in the list or the reader would rather choose by name.
      Any branch can be the source; only a local one can be written to.
    -->
    <Border DockPanel.Dock="Top"
            Name="ManualMerge"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10"
            IsVisible="{Binding IsRepositoryOpen}">
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="8">
          <ei:Icon Kind="GitMerge" Classes="row dim" VerticalAlignment="Center" />
          <TextBlock Text="Merge"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Classes="dim" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Source"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Classes="dim" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  Name="MergeSource"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding MergeSources}"
                  SelectedItem="{Binding SelectedMergeSource, Mode=TwoWay}"
                  PlaceholderText="The branch to bring over"
                  AutomationProperties.Name="The branch to merge from" />

        <TextBlock Grid.Row="1" Grid.Column="2"
                   Text="into"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Classes="dim" />
        <ComboBox Grid.Row="1" Grid.Column="3"
                  Name="MergeDestination"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding MergeDestinations}"
                  SelectedItem="{Binding SelectedMergeDestination, Mode=TwoWay}"
                  PlaceholderText="The branch to write to"
                  AutomationProperties.Name="The branch to merge into" />

        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <Button Classes="accent"
                  Command="{Binding ManualMergeCommand}"
                  Content="Merge"
                  ToolTip.Tip="Merge the source into the destination, always recording a merge commit — even when a fast-forward would do — and checking the destination out first when it is not the current branch"
                  AutomationProperties.Name="Merge the source into the destination" />
          <Button Command="{Binding ManualFastForwardCommand}"
                  Content="Merge fast-forward"
                  ToolTip.Tip="Move the destination forward onto the source without a merge commit, refusing when the two have diverged"
                  AutomationProperties.Name="Fast-forward the destination to the source" />
          <Button Command="{Binding ClearManualMergeCommand}"
                  Content="Clear"
                  AutomationProperties.Name="Clear the source and the destination" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="GitBranch"
                           Title="Branches"
                           Message="{Binding EmptyMessage}"
                           IsVisible="{Binding IsEmpty}"
                           ZIndex="1" />

      <!-- Several at once: Ctrl+click adds or takes away one, Shift+click a range, Ctrl+A every branch
           the open nodes show; a right-click outside the selection selects that line first, and one
           inside keeps the selection. A folder or a top-level node is never part of it. -->
      <TreeView Name="BranchTree"
                Classes="rows"
                SelectionMode="Multiple"
                ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectedItems="{Binding SelectedNodes}"
                AutomationProperties.Name="Branches">

        <TreeView.KeyBindings>
          <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}" />
        </TreeView.KeyBindings>

        <TreeView.Styles>
          <!-- The item's own DataContext is the node, so the selector's x:DataType has to say so:
               without it the compiled binding resolves against the page's ViewModel instead. -->
          <Style Selector="TreeViewItem" x:DataType="vm:BranchTreeNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>

        <TreeView.DataTemplates>
          <!-- "Local", or a remote: this machine's mark or a remote's, where a file has its chip. -->
          <TreeDataTemplate DataType="vm:BranchGroupViewModel" x:DataType="vm:BranchGroupViewModel" ItemsSource="{Binding Children}">
            <Grid Classes="listrow" ColumnDefinitions="Auto,*,Auto">
              <Panel Grid.Column="0" VerticalAlignment="Center">
                <ei:Icon Kind="Desktop" Classes="row dim" IsVisible="{Binding !IsRemote}" />
                <ei:Icon Kind="HardDrives" Classes="row dim" IsVisible="{Binding IsRemote}" />
              </Panel>
              <TextBlock Grid.Column="1" Classes="rowname" Text="{Binding Title}" />
              <TextBlock Grid.Column="2" Classes="rowdetail faint" Text="{Binding Count}" />
            </Grid>
          </TreeDataTemplate>

          <TreeDataTemplate DataType="vm:BranchFolderViewModel" x:DataType="vm:BranchFolderViewModel" ItemsSource="{Binding Children}">
            <Grid Classes="listrow" ColumnDefinitions="Auto,*,Auto">
              <ei:Icon Grid.Column="0" Kind="Folder" Classes="row dim" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="rowname" Text="{Binding Label}" />
              <TextBlock Grid.Column="2" Classes="rowdetail faint" Text="{Binding Count}" />
            </Grid>
          </TreeDataTemplate>

          <DataTemplate DataType="vm:BranchRowViewModel" x:DataType="vm:BranchRowViewModel">
            <Grid Classes="listrow" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding ToolTip}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Select in the history"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding SelectInHistoryCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="Crosshair" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding !Selection.IsMultiple}" />
                  <MenuItem Header="Check out"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding CheckoutCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="SignIn" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Merge into the current branch"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding MergeCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="GitMerge" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{Binding VisibilityHeader}"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding ToggleVisibilityCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <Panel>
                        <ei:Icon Kind="Eye" Classes="menu" IsVisible="{Binding IsHiddenInHistory}" />
                        <ei:Icon Kind="EyeSlash" Classes="menu" IsVisible="{Binding !IsHiddenInHistory}" />
                      </Panel>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding !Selection.IsMultiple}" />
                  <MenuItem Header="Rename…"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding RenameCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="PencilSimple" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Set upstream…"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding SetUpstreamCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="LinkSimple" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding !Selection.IsMultiple}" />
                  <MenuItem Header="Delete…"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="Trash" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Grid.ContextMenu>

              <!-- Where a file has its status chip: the branch's mark, so names line up with folders. -->
              <ei:Icon Grid.Column="0" Kind="GitBranch" Classes="row dim" VerticalAlignment="Center" />

              <TextBlock Grid.Column="1" Classes="rowname" Text="{Binding Label}" />

              <!-- The badges, each only when it applies, in the order they matter when scanning the
                   list: checked out, hidden, ahead, behind, local only. Each says what it means. -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Classes="badge"
                            IsVisible="{Binding IsCurrent}"
                            ToolTip.Tip="{Binding CheckedOutTip}"
                            AutomationProperties.Name="{Binding CheckedOutTip}">
                  <TextBlock Classes="rowdetail faint" Text="checked out" />
                </StackPanel>

                <StackPanel Classes="badge"
                            IsVisible="{Binding IsHiddenInHistory}"
                            ToolTip.Tip="{Binding HiddenTip}"
                            AutomationProperties.Name="{Binding HiddenTip}">
                  <ei:Icon Kind="EyeSlash" Classes="pill faint" VerticalAlignment="Center" />
                  <TextBlock Classes="rowdetail faint" Text="hidden" />
                </StackPanel>

                <StackPanel Classes="badge"
                            IsVisible="{Binding IsAhead}"
                            ToolTip.Tip="{Binding AheadTip}"
                            AutomationProperties.Name="{Binding AheadTip}">
                  <ei:Icon Kind="ArrowUp" Classes="pill faint" VerticalAlignment="Center" />
                  <TextBlock Classes="rowdetail faint" Text="{Binding Ahead}" />
                </StackPanel>

                <StackPanel Classes="badge"
                            IsVisible="{Binding IsBehind}"
                            ToolTip.Tip="{Binding BehindTip}"
                            AutomationProperties.Name="{Binding BehindTip}">
                  <ei:Icon Kind="ArrowDown" Classes="pill faint" VerticalAlignment="Center" />
                  <TextBlock Classes="rowdetail faint" Text="{Binding Behind}" />
                </StackPanel>

                <StackPanel Classes="badge"
                            IsVisible="{Binding IsLocalOnly}"
                            ToolTip.Tip="{Binding LocalOnlyTip}"
                            AutomationProperties.Name="{Binding LocalOnlyTip}">
                  <TextBlock Classes="rowdetail faint" Text="local only" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </Grid>
  </DockPanel>
</UserControl>
