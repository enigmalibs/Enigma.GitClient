<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
             xmlns:gitcontrols="using:Enigma.GitClient.Desktop.Controls"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Pages"
             x:Class="Enigma.GitClient.Desktop.Views.Pages.ProfilesPageView"
             x:DataType="vm:ProfilesPageViewModel">

  <UserControl.Styles>
    <!-- A profile's actions are a row's own actions, framed no more than a list row's are. -->
    <Style Selector="ItemsControl.profiles Button.toolbar.rowaction">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,6" />
    </Style>
    <Style Selector="ItemsControl.integrations Button.toolbar.rowaction">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,6" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>

    <!-- One integration: the account, where it is, and what can be done with it. An earlier one,
         which belongs to no profile yet, also offers the profiles it can be moved to. -->
    <DataTemplate x:Key="IntegrationRow" x:DataType="vm:HostAccountRowViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,2">

        <ei:Icon Grid.Column="0"
                 Kind="{Binding Icon}"
                 Classes="row dim"
                 VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayName}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
          <TextBlock Classes="faint"
                     Text="{Binding Details}"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis" />
          <!-- No token, or one that cannot be read: git signs in on its own until it is replaced. -->
          <TextBlock Text="{Binding TokenProblem}"
                     IsVisible="{Binding HasTokenProblem}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource EnigmaWarningBrush}" />
        </StackPanel>

        <Button Grid.Column="2"
                Classes="choice"
                Command="{Binding ReplaceTokenCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding HasTokenProblem}"
                VerticalAlignment="Center"
                ToolTip.Tip="Type a new personal access token for this account"
                AutomationProperties.Name="Replace the token">
          <TextBlock Text="Replace token" />
        </Button>

        <Button Grid.Column="3"
                Classes="choice"
                IsVisible="{Binding HasMoveTargets}"
                VerticalAlignment="Center"
                ToolTip.Tip="Give this integration to the profile it is for"
                AutomationProperties.Name="Move to a profile">
          <TextBlock Text="Move to…" />
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding MoveTargets}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem"
                              BasedOn="{StaticResource {x:Type MenuItem}}"
                              x:DataType="vm:AccountMoveTargetViewModel">
                  <Setter Property="Header" Value="{Binding Header}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Grid.Column="4"
                Classes="choice"
                Command="{Binding BrowseCommand}"
                CommandParameter="{Binding}"
                VerticalAlignment="Center"
                ToolTip.Tip="List the repositories this account can reach, to open or clone one"
                AutomationProperties.Name="Browse repositories">
          <TextBlock Text="Browse repositories" />
        </Button>

        <Button Grid.Column="5"
                Classes="toolbar rowaction"
                Command="{Binding RemoveCommand}"
                CommandParameter="{Binding}"
                VerticalAlignment="Center"
                ToolTip.Tip="Disconnect this account and delete its token"
                AutomationProperties.Name="Disconnect this account">
          <ei:Icon Kind="Trash" Classes="row" />
        </Button>
      </Grid>
    </DataTemplate>

    <!-- One profile: a card of its own, with the accounts it is connected to inside it, so where one
         profile ends and the next begins is never a question. Its mark is a monogram of its label,
         which tells two profiles apart where one picture for all of them could not. The profile git
         commits as is outlined in the accent and says so in words. -->
    <DataTemplate x:Key="ProfileRow" x:DataType="vm:ProfileRowViewModel">
      <Border Classes="profilecard" Classes.active="{Binding IsCurrent}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">

            <gitcontrols:AuthorAvatar Grid.Column="0"
                                      Classes="profile"
                                      Initials="{Binding Initials}"
                                      Seed="{Binding Label}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Label}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource EnigmaForegroundBrush}" />
              <TextBlock Classes="dim"
                         Text="{Binding Summary}"
                         FontSize="13"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Which profile git commits as, in words and not by the outline alone; and on every
                 other profile that has a name and an email, the way to switch to it. The two share
                 one place and never show together. A profile without a name and email has neither:
                 switching to it would unset git's identity. -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        IsVisible="{Binding IsCurrent}"
                        ToolTip.Tip="Git commits as this profile: your global configuration has its name and email"
                        AutomationProperties.Name="Active profile">
              <ei:Icon Kind="CheckCircle"
                       Weight="Fill"
                       Classes="toolbar"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ActionAccentBrush}" />
              <TextBlock Text="Active"
                         FontSize="13"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundBrush}" />
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="toolbar"
                    Command="{Binding UseCommand}"
                    CommandParameter="{Binding}"
                    IsVisible="{Binding CanUse}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Make this profile's name and email your global git identity, so new commits are made as this profile"
                    AutomationProperties.Name="Make this profile active">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ei:Icon Kind="UserSwitch" Classes="toolbar" VerticalAlignment="Center" />
                <TextBlock Text="Make active" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Classes="toolbar rowaction"
                    Command="{Binding EditCommand}"
                    CommandParameter="{Binding}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Edit this profile"
                    AutomationProperties.Name="Edit this profile">
              <ei:Icon Kind="PencilSimple" Classes="row" />
            </Button>

            <Button Grid.Column="4"
                    Classes="toolbar rowaction"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Delete this profile; your git configuration is not changed"
                    AutomationProperties.Name="Delete this profile">
              <ei:Icon Kind="Trash" Classes="row" />
            </Button>
          </Grid>

          <Border Classes="profilerule" />

          <!-- The accounts this profile is connected to, lined up with its name: past the monogram
               (36 px) and the header's column spacing (12). -->
          <StackPanel Margin="48,0,0,0" Spacing="4">
            <ItemsControl Classes="integrations"
                          ItemsSource="{Binding Integrations}"
                          ItemTemplate="{StaticResource IntegrationRow}"
                          IsVisible="{Binding HasIntegrations}"
                          AutomationProperties.Name="Integrations of this profile" />

            <!-- A profile without integrations pushes nowhere: the push check refuses it. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        IsVisible="{Binding !HasIntegrations}"
                        ToolTip.Tip="Commits made as this profile stay on this machine until it is connected to the host they go to">
              <ei:Icon Kind="LockSimple" Size="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
              <TextBlock Text="Local only — no integration, so this profile never pushes."
                         FontSize="11"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
            </StackPanel>

            <Button Classes="toolbar"
                    HorizontalAlignment="Left"
                    Command="{Binding ConnectCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="Connect a GitHub, GitLab or Azure DevOps account to this profile with a personal access token"
                    AutomationProperties.Name="Connect an account to this profile">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
                <TextBlock Text="Connect an account" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <!--
    Who git says made a commit: the global identity every repository inherits, the profiles that
    switch it — each with the hosting accounts it is connected to — and, in a repository's window, the
    identity that repository sets for itself. It is git's own configuration being edited, so each
    section saves on its own button rather than on every keystroke.
  -->
  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ei:Icon Kind="IdentificationCard" Classes="header" VerticalAlignment="Center"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
        <TextBlock Text="{Binding Title}"
                   VerticalAlignment="Center"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource EnigmaForegroundBrush}" />
      </StackPanel>
    </Border>

    <!-- Stored tokens this account can no longer read — what a Windows password reset leaves behind:
         said before anything fails, with the way out, as the repository window's operation banner says
         what is in progress (BUG-3024). -->
    <Border Name="TokenStoreBand"
            DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaWarningBackgroundBrush}"
            BorderBrush="{DynamicResource EnigmaWarningBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8"
            IsVisible="{Binding IsTokenStoreUnreadable}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <ei:Icon Grid.Column="0" Kind="Warning" Classes="row" VerticalAlignment="Center"
                 Foreground="{DynamicResource EnigmaWarningBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding TokenStoreProblem}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource EnigmaForegroundBrush}" />
        <Button Grid.Column="2"
                Classes="toolbar"
                Command="{Binding ResetStoredTokensCommand}"
                ToolTip.Tip="Delete every stored token, so each integration can be given its token again"
                AutomationProperties.Name="Reset stored tokens">
          <TextBlock Text="Reset stored tokens" FontSize="12" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer>
      <!-- The settings page's column: centred, with a ceiling on its width. -->
      <StackPanel Margin="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">

        <!-- The global identity -->
        <controls:SettingsCardExpander Header="Global identity"
                                       Description="The name and email git records on every commit, unless a repository sets its own"
                                       IconData="{ei:IconGeometry Globe}"
                                       IsExpanded="True">
          <StackPanel Spacing="12">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Name"
                           FontSize="12"
                           Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                <TextBox Text="{Binding GlobalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Ada Lovelace"
                         AutomationProperties.Name="Global name" />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Email"
                           FontSize="12"
                           Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                <TextBox Text="{Binding GlobalEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="ada@example.com"
                         AutomationProperties.Name="Global email" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        IsVisible="{Binding HasGlobalError}">
              <ei:Icon Kind="Warning" Size="14" VerticalAlignment="Top"
                       Foreground="{DynamicResource EnigmaErrorBrush}" />
              <TextBlock Text="{Binding GlobalError}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource EnigmaErrorBrush}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ei:Icon Kind="Warning" Size="14" VerticalAlignment="Top"
                         IsVisible="{Binding IsGlobalUnset}"
                         Foreground="{DynamicResource EnigmaWarningBrush}" />
                <TextBlock Text="{Binding GlobalSummary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
              </StackPanel>

              <Button Grid.Column="1"
                      Classes="accent"
                      Command="{Binding SaveGlobalCommand}"
                      ToolTip.Tip="Write this name and email to your global git configuration"
                      AutomationProperties.Name="Save the global identity">
                <TextBlock Text="Save" />
              </Button>
            </Grid>
          </StackPanel>
        </controls:SettingsCardExpander>

        <!-- Profiles -->
        <controls:SettingsCardExpander Header="Profiles"
                                       Description="Who you commit as, and the hosting accounts each profile is connected to"
                                       IconData="{ei:IconGeometry UserSwitch}"
                                       IsExpanded="True">
          <StackPanel Spacing="10">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Grid.Column="0"
                         Text="No profiles yet. Add one for each identity you commit as — work, personal — and switch between them with Make active."
                         IsVisible="{Binding !HasProfiles}"
                         VerticalAlignment="Center"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

              <Button Grid.Column="1"
                      Classes="toolbar"
                      Command="{Binding AddProfileCommand}"
                      ToolTip.Tip="Keep a name and email under a label, starting from your global identity"
                      AutomationProperties.Name="Add a profile">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
                  <TextBlock Text="Add a profile" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- One card per profile, with room between two cards: a frame touching the next reads
                 as one box. -->
            <ItemsControl Classes="profiles"
                          ItemsSource="{Binding Profiles}"
                          ItemTemplate="{StaticResource ProfileRow}"
                          IsVisible="{Binding HasProfiles}"
                          AutomationProperties.Name="Identity profiles">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </controls:SettingsCardExpander>

        <!-- Integrations that belong to no profile: only while there are some. -->
        <controls:SettingsCardExpander Header="Earlier integrations"
                                       Description="Connected before integrations belonged to a profile. Until one is moved into a profile, no profile uses it"
                                       IconData="{ei:IconGeometry GlobeSimple}"
                                       IsExpanded="True"
                                       IsVisible="{Binding HasEarlierIntegrations}">
          <StackPanel Spacing="10">
            <TextBlock Text="Add a profile above to give these integrations one."
                       IsVisible="{Binding !HasProfiles}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

            <ItemsControl Classes="integrations"
                          ItemsSource="{Binding EarlierIntegrations}"
                          ItemTemplate="{StaticResource IntegrationRow}"
                          AutomationProperties.Name="Earlier integrations" />
          </StackPanel>
        </controls:SettingsCardExpander>

        <!-- The open repository's own identity: only in a repository's window. -->
        <controls:SettingsCardExpander Header="{Binding RepositoryName, StringFormat='This repository: {0}'}"
                                       Description="A name and email of its own, which its commits use whatever the global identity is"
                                       IconData="{ei:IconGeometry FolderUser}"
                                       IsExpanded="True"
                                       IsVisible="{Binding IsRepositoryOpen}">
          <StackPanel Spacing="12">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Name"
                           FontSize="12"
                           Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                <TextBox Text="{Binding LocalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Not set: the global name is used"
                         AutomationProperties.Name="This repository's name" />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Email"
                           FontSize="12"
                           Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                <TextBox Text="{Binding LocalEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Not set: the global email is used"
                         AutomationProperties.Name="This repository's email" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        IsVisible="{Binding HasLocalError}">
              <ei:Icon Kind="Warning" Size="14" VerticalAlignment="Top"
                       Foreground="{DynamicResource EnigmaErrorBrush}" />
              <TextBlock Text="{Binding LocalError}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource EnigmaErrorBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding LocalSummary}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="toolbar"
                      Command="{Binding CopyFromCurrentProfileCommand}"
                      ToolTip.Tip="Fill these fields with the name and email of the active profile"
                      ToolTip.ShowOnDisabled="True"
                      AutomationProperties.Name="Copy from the active profile">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ei:Icon Kind="Copy" Classes="toolbar" VerticalAlignment="Center" />
                  <TextBlock Text="Copy from active profile" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="toolbar"
                      Command="{Binding RemoveLocalCommand}"
                      ToolTip.Tip="Remove this repository's own name and email, so its commits use the global identity"
                      AutomationProperties.Name="Remove this repository's identity">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ei:Icon Kind="Eraser" Classes="toolbar" VerticalAlignment="Center" />
                  <TextBlock Text="Remove" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="accent"
                      Command="{Binding SaveLocalCommand}"
                      ToolTip.Tip="Write this name and email to this repository's own git configuration"
                      AutomationProperties.Name="Save this repository's identity">
                <TextBlock Text="Save" />
              </Button>
            </StackPanel>
          </StackPanel>
        </controls:SettingsCardExpander>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
