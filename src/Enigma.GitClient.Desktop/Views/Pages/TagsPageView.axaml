<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.Desktop.Controls"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Pages"
             x:Class="Enigma.GitClient.Desktop.Views.Pages.TagsPageView"
             x:DataType="vm:TagsPageViewModel">

  <!--
    The tags page: the branches page's header, and a flat list of compact lines drawn like the
    changed files beside the history — one per tag, its name and nothing else. Everything else about a
    tag is in its line's tooltip, and everything that can be done to one is in its line's menu. What
    it does not share with the branches page is the drag gesture: dropping one reference onto another
    means a merge, and a tag is not something to merge.
  -->

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <ei:Icon Kind="Tag" Classes="header" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          <TextBlock Text="{Binding Title}"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </StackPanel>

        <TextBox Grid.Column="1"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 MaxWidth="320"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 AutomationProperties.Name="Filter tags" />

        <!-- The order of the lines: by name or by the tagged commit's date, and which way. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Sort by"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Classes="dim" />
          <ComboBox Name="SortKey"
                    ItemsSource="{Binding SortKeys}"
                    SelectedItem="{Binding SortKey, Mode=TwoWay}"
                    MinWidth="90"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sort the tags by" />
          <Button Name="SortDirection"
                  Classes="toolbar"
                  Command="{Binding ToggleSortDirectionCommand}"
                  ToolTip.Tip="{Binding SortDirectionTip}"
                  AutomationProperties.Name="{Binding SortDirectionTip}">
            <Panel>
              <ei:Icon Kind="SortAscending" Classes="toolbar" IsVisible="{Binding !IsSortDescending}" />
              <ei:Icon Kind="SortDescending" Classes="toolbar" IsVisible="{Binding IsSortDescending}" />
            </Panel>
          </Button>
        </StackPanel>

        <!-- The selected tags, deleted here: red while there is any to delete, as every button that
             loses something is. The Delete key on the list does the same. -->
        <Button Grid.Column="3"
                Name="DeleteSelection"
                Classes="toolbar danger"
                Command="{Binding DeleteSelectionCommand}"
                ToolTip.Tip="Delete the selected tags here"
                AutomationProperties.Name="Delete the selected tags">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Trash" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DeleteSelectionLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="4"
                Classes="toolbar"
                Command="{Binding CreateCommand}"
                ToolTip.Tip="Create a tag"
                AutomationProperties.Name="Create a tag">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="New tag" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="Tag"
                           Title="Tags"
                           Message="{Binding EmptyMessage}"
                           IsVisible="{Binding IsEmpty}"
                           ZIndex="1" />

      <!-- Several at once: Ctrl+click adds or takes away one, Shift+click a range, Ctrl+A every tag
           the filter shows; a right-click outside the selection selects that line first, and one
           inside keeps the selection. -->
      <ListBox Name="TagList"
               Classes="rows"
               SelectionMode="Multiple"
               ItemsSource="{Binding Tags}"
               SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
               SelectedItems="{Binding SelectedTags}"
               AutomationProperties.Name="Tags">

        <ListBox.KeyBindings>
          <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}" />
        </ListBox.KeyBindings>

        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TagRowViewModel">
            <Grid Classes="listrow" ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding ToolTip}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <!-- What works on one tag is offered while one is selected; with several, only the
                       deletes, which act on all of them. -->
                  <MenuItem Header="Select in the history"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding SelectInHistoryCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="Crosshair" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding !Selection.IsMultiple}" />
                  <MenuItem Header="Check out (detaches HEAD)"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding CheckoutCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="SignIn" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <!-- The tag on its own, to where the current branch pushes: the history's tag badge
                       offers the same push. -->
                  <MenuItem Header="Push to the remote"
                            Command="{Binding PushCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanPush" />
                        <Binding Path="!Selection.IsMultiple" />
                      </MultiBinding>
                    </MenuItem.IsVisible>
                    <MenuItem.Icon>
                      <ei:Icon Kind="ArrowUp" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding !Selection.IsMultiple}" />
                  <!-- Here, or on the remote the push goes to: the history's tag badge offers the same
                       two, and the question each asks names which copy goes. -->
                  <MenuItem Header="Delete locally…"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="Trash" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Delete from the remote…"
                            IsVisible="{Binding CanDeleteRemote}"
                            Command="{Binding DeleteRemoteCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="CloudX" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Grid.ContextMenu>

              <!-- Where a file's line has its status chip: the tag's own mark, so the names line up. -->
              <ei:Icon Grid.Column="0"
                       Kind="Tag"
                       Classes="row dim"
                       VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Classes="rowname"
                         Text="{Binding Name}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
