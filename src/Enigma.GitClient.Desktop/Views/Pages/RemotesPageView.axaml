<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.Desktop.Controls"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Pages"
             x:Class="Enigma.GitClient.Desktop.Views.Pages.RemotesPageView"
             x:DataType="vm:RemotesPageViewModel">

  <!--
    The remotes page: a flat list of compact lines drawn like the changed files beside the history —
    the remote's name, and its fetch URL to the right, faint, cut short when it is too long. The host,
    and where pushes go when that is elsewhere, are in the line's tooltip; what can be done to a
    remote is in its line's menu.
  -->

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <ei:Icon Kind="CloudArrowUp" Classes="header" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          <TextBlock Text="{Binding Title}"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </StackPanel>

        <!-- The selected remotes, removed: red while there is any to remove. The Delete key on the list
             does the same. Remove, the remotes' own verb: nothing on the remote itself is deleted. -->
        <Button Grid.Column="2"
                Name="RemoveSelection"
                Classes="toolbar danger"
                Command="{Binding RemoveSelectionCommand}"
                ToolTip.Tip="Remove the selected remotes"
                AutomationProperties.Name="Remove the selected remotes">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Trash" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RemoveSelectionLabel}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3"
                Classes="toolbar"
                Command="{Binding AddCommand}"
                ToolTip.Tip="Add a remote"
                AutomationProperties.Name="Add a remote">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="New remote" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="CloudArrowUp"
                           Title="Remotes"
                           Message="{Binding EmptyMessage}"
                           IsVisible="{Binding IsEmpty}"
                           ZIndex="1" />

      <!-- Several at once, as on the tags page: Ctrl+click, Shift+click, Ctrl+A. -->
      <ListBox Name="RemoteList"
               Classes="rows"
               SelectionMode="Multiple"
               IsVisible="{Binding !IsEmpty}"
               ItemsSource="{Binding Remotes}"
               SelectedItem="{Binding SelectedRemote, Mode=TwoWay}"
               SelectedItems="{Binding SelectedRemotes}"
               AutomationProperties.Name="Remotes">
        <ListBox.KeyBindings>
          <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectionCommand}" />
        </ListBox.KeyBindings>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RemoteRowViewModel">
            <!-- The name keeps its width, and the URL takes what is left, from the right. -->
            <Grid Classes="listrow" ColumnDefinitions="Auto,Auto,*" ToolTip.Tip="{Binding ToolTip}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <!-- What works on one remote is offered while one is selected; with several, only the
                       remove, which acts on all of them. -->
                  <MenuItem Header="Fetch"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding FetchCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="ArrowsDownUp" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding !Selection.IsMultiple}" />
                  <MenuItem Header="Edit…"
                            IsVisible="{Binding !Selection.IsMultiple}"
                            Command="{Binding EditCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="PencilSimple" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Remove…"
                            Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding}">
                    <MenuItem.Icon>
                      <ei:Icon Kind="Trash" Classes="menu" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Grid.ContextMenu>

              <!-- Where a file's line has its status chip: the remote's own mark, so the names line up. -->
              <ei:Icon Grid.Column="0"
                       Kind="HardDrives"
                       Classes="row dim"
                       VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Classes="rowname"
                         Text="{Binding Name}" />

              <TextBlock Grid.Column="2"
                         Classes="rowdetail faint"
                         Text="{Binding FetchUrl}"
                         HorizontalAlignment="Right"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
