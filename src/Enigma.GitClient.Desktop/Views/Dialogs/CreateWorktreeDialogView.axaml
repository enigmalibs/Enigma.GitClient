<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Dialogs"
             x:Class="Enigma.GitClient.Desktop.Views.Dialogs.CreateWorktreeDialogView"
             x:DataType="vm:CreateWorktreeDialogViewModel"
             MinWidth="520">
  <StackPanel Spacing="12">

    <StackPanel Spacing="4">
      <TextBlock Text="Branch to create"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="feature/what-it-does"
               AutomationProperties.Name="Branch to create" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Starts from"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ei:Icon Kind="GitCommit" Size="14" VerticalAlignment="Center"
                 Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
        <TextBlock Text="{Binding StartPointLabel}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource EnigmaForegroundBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- Next to the repository, never inside: the proposal follows the branch until it is edited. -->
    <StackPanel Spacing="4">
      <TextBlock Text="Working directory"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Working directory" />
        <Button Grid.Column="1"
                Command="{Binding BrowseCommand}"
                AutomationProperties.Name="Choose where to put the worktree's folder"
                ToolTip.Tip="Choose where to put the worktree's folder">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="FolderOpen" Size="15" VerticalAlignment="Center" />
            <TextBlock Text="Browse" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>

    <CheckBox IsChecked="{Binding OpenAfterCreate, Mode=TwoWay}"
              Content="Open it in a new window once it is created"
              AutomationProperties.Name="Open it in a new window once it is created" />

    <StackPanel Orientation="Horizontal"
                Spacing="6"
                IsVisible="{Binding HasValidationMessage}">
      <ei:Icon Kind="Warning" Size="14" VerticalAlignment="Top"
               Foreground="{DynamicResource EnigmaErrorBrush}" />
      <TextBlock Text="{Binding ValidationMessage}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 MaxWidth="480"
                 Foreground="{DynamicResource EnigmaErrorBrush}" />
    </StackPanel>
  </StackPanel>
</UserControl>
