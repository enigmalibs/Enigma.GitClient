<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Dialogs"
             x:Class="Enigma.GitClient.Desktop.Views.Dialogs.IdentityProfileDialogView"
             x:DataType="vm:IdentityProfileDialogViewModel"
             MinWidth="460">
  <StackPanel Spacing="12">

    <StackPanel Spacing="4">
      <TextBlock Text="Profile"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Work, personal, …"
               AutomationProperties.Name="Profile name" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Name"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Ada Lovelace"
               AutomationProperties.Name="Name git records" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Email"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="ada@example.com"
               AutomationProperties.Name="Email git records" />
    </StackPanel>

    <TextBlock Text="Leave both empty for a profile git never sees: commits, pushes and sign-ins go on as if it did not exist."
               FontSize="12"
               TextWrapping="Wrap"
               Classes="faint" />

    <StackPanel Spacing="4">
      <TextBlock Text="Base directory"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Text="{Binding BaseDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Optional"
                 AutomationProperties.Name="Base directory" />
        <Button Grid.Column="1"
                Command="{Binding BrowseCommand}"
                AutomationProperties.Name="Choose the base directory"
                ToolTip.Tip="Choose a folder">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="FolderOpen" Size="15" VerticalAlignment="Center" />
            <TextBlock Text="Browse" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>

    <TextBlock Text="Where Open, Clone and Create start on the home page while this profile is selected."
               FontSize="12"
               TextWrapping="Wrap"
               Classes="faint" />

    <StackPanel Orientation="Horizontal"
                Spacing="6"
                IsVisible="{Binding HasValidationMessage}">
      <ei:Icon Kind="Warning" Size="14" VerticalAlignment="Top"
               Foreground="{DynamicResource EnigmaErrorBrush}" />
      <TextBlock Text="{Binding ValidationMessage}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource EnigmaErrorBrush}" />
    </StackPanel>
  </StackPanel>
</UserControl>
