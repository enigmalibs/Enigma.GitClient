<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels.Dialogs"
             x:Class="Enigma.GitClient.Desktop.Views.Dialogs.StashDialogView"
             x:DataType="vm:StashDialogViewModel"
             MinWidth="480">
  <StackPanel Spacing="12">

    <TextBlock Text="{Binding Summary}"
               FontSize="12"
               TextWrapping="Wrap"
               MaxWidth="440"
               HorizontalAlignment="Left"
               Foreground="{DynamicResource EnigmaForegroundBrush}" />

    <StackPanel Spacing="4">
      <TextBlock Text="Message (optional)"
                 FontSize="12"
                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <TextBox Name="MessageBox"
               Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="What this work in progress is"
               AutomationProperties.Name="Stash message" />
      <TextBlock Text="Left empty, git names it after the branch and its last commit."
                 FontSize="11"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
    </StackPanel>
  </StackPanel>
</UserControl>
