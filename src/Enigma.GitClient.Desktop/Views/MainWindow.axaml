<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ei="https://github.com/josueclement/Enigma.Icons"
        xmlns:vm="using:Enigma.GitClient.Desktop.ViewModels"
        xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
        xmlns:contentDialog="using:Enigma.Avalonia.Desktop.Controls.ContentDialog"
        xmlns:infoBar="using:Enigma.Avalonia.Desktop.Controls.InfoBar"
        xmlns:nav="using:Enigma.Avalonia.Desktop.Controls.Navigation"
        x:Class="Enigma.GitClient.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource EnigmaBackgroundBrush}">

  <!--
    Opened maximised, every time: the history wants every pixel. Centred too, so the size it is
    restored to — 1440 × 900 — lands in the middle of the screen, as the start window does.
  -->
  <Panel>
    <DockPanel>

      <!-- Repository strip: which repository is open, where HEAD is, and what is in progress. -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource EnigmaSurfaceBrush}"
              BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,8">
        <Grid ColumnDefinitions="Auto,*,Auto">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <ei:Icon Kind="Folder" Classes="header" VerticalAlignment="Center"
                     Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
            <TextBlock Text="{Binding RepositoryName}"
                       ToolTip.Tip="{Binding RepositoryPath}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource EnigmaForegroundBrush}" />

            <!-- A linked worktree says whose it is. The border catches the pointer for the tip: an
                 icon alone is hit only where it has ink. -->
            <Border Name="LinkedWorktreeMark"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsLinkedWorktree}"
                    ToolTip.Tip="{Binding LinkedWorktreeTip}"
                    AutomationProperties.Name="{Binding LinkedWorktreeTip}">
              <ei:Icon Kind="Tree" Classes="header"
                       Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
            </Border>

            <Border Classes="pill"
                    Background="{DynamicResource EnigmaSelectionBrush}"
                    IsVisible="{Binding RepositoryContext.IsRepositoryOpen}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ei:Icon Kind="GitBranch" Classes="pill" VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                <TextBlock Text="{Binding HeadDisplayName}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource EnigmaForegroundBrush}" />
              </StackPanel>
            </Border>

            <Border Classes="pill"
                    Background="{DynamicResource EnigmaWarningBackgroundBrush}"
                    BorderBrush="{DynamicResource EnigmaWarningBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding IsHeadDetached}">
              <TextBlock Text="detached HEAD"
                         FontSize="12"
                         Foreground="{DynamicResource EnigmaForegroundBrush}" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">

            <!-- Fetch, pull and push, with the counters that say whether either is worth doing. -->
            <Button Classes="toolbar"
                    IsVisible="{Binding CanSync}"
                    Command="{Binding FetchCommand}"
                    ToolTip.Tip="Fetch from every remote"
                    AutomationProperties.Name="Fetch from every remote">
              <ei:Icon Kind="ArrowsDownUp" Classes="toolbar" />
            </Button>

            <Button Classes="toolbar"
                    IsVisible="{Binding CanSync}"
                    Command="{Binding PullCommand}"
                    ToolTip.Tip="Pull into the current branch"
                    AutomationProperties.Name="Pull into the current branch">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ei:Icon Kind="ArrowDown" Classes="toolbar" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Behind}"
                           IsVisible="{Binding IsBehind}"
                           VerticalAlignment="Center"
                           FontSize="12" />
              </StackPanel>
            </Button>

            <Button Classes="toolbar"
                    IsVisible="{Binding CanSync}"
                    Command="{Binding PushCommand}"
                    ToolTip.Tip="Push the current branch"
                    AutomationProperties.Name="Push the current branch">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ei:Icon Kind="ArrowUp" Classes="toolbar" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Ahead}"
                           IsVisible="{Binding IsAhead}"
                           VerticalAlignment="Center"
                           FontSize="12" />
              </StackPanel>
            </Button>

            <Border Width="1"
                    Margin="4,6"
                    IsVisible="{Binding CanSync}"
                    Background="{DynamicResource EnigmaBorderSubtleBrush}" />

            <!-- The repository's folder, outside the client: in the file manager, and in a terminal. -->
            <Button Name="OpenFolder"
                    Classes="toolbar"
                    IsVisible="{Binding CanSync}"
                    Command="{Binding OpenFolderCommand}"
                    ToolTip.Tip="Open the repository's folder in the file manager"
                    AutomationProperties.Name="Open the repository's folder">
              <ei:Icon Kind="FolderOpen" Classes="toolbar" />
            </Button>
            <Button Name="OpenTerminal"
                    Classes="toolbar"
                    IsVisible="{Binding CanSync}"
                    Command="{Binding OpenTerminalCommand}"
                    ToolTip.Tip="Open a terminal in the repository's folder"
                    AutomationProperties.Name="Open a terminal in the repository's folder">
              <ei:Icon Kind="TerminalWindow" Classes="toolbar" />
            </Button>

            <Border Width="1"
                    Margin="4,6"
                    IsVisible="{Binding CanSync}"
                    Background="{DynamicResource EnigmaBorderSubtleBrush}" />

            <Button Classes="toolbar"
                    Command="{Binding CloseRepositoryCommand}"
                    ToolTip.Tip="Close this repository and go back to the start window"
                    AutomationProperties.Name="Close the repository">
              <ei:Icon Kind="SignOut" Classes="toolbar" />
            </Button>
            <Button Classes="toolbar"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Refresh everything: fetch from every remote, then read the repository again"
                    AutomationProperties.Name="Refresh everything">
              <ei:Icon Kind="ArrowsClockwise" Classes="toolbar" />
            </Button>
            <Button Classes="toolbar"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip.Tip="Switch between the dark and light themes"
                    AutomationProperties.Name="Switch between the dark and light themes">
              <ei:Icon Kind="Palette" Classes="toolbar" />
            </Button>
            <Button Name="OpenAbout"
                    Classes="toolbar"
                    Command="{Binding OpenAboutCommand}"
                    ToolTip.Tip="About"
                    AutomationProperties.Name="About Enigma Git Client">
              <ei:Icon Kind="Info" Classes="toolbar" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Operation banner: shown only while the repository is mid-merge, mid-revert and so on. -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource EnigmaWarningBackgroundBrush}"
              BorderBrush="{DynamicResource EnigmaWarningBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,8"
              IsVisible="{Binding HasOperationInProgress}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <ei:Icon Grid.Column="0" Kind="Warning" Classes="row" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaWarningBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding OperationDescription}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />

          <!-- Everything a merge in progress can lead to, where the merge is announced: how far it
               has got, the page that gets it further, and its two endings. -->
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="6"
                      IsVisible="{Binding IsMergeInProgress}">

            <TextBlock Text="{Binding Conflicts.Progress}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Margin="0,0,4,0"
                       Foreground="{DynamicResource EnigmaForegroundBrush}" />

            <Button Classes="toolbar"
                    Command="{Binding ResolveConflictsCommand}"
                    ToolTip.Tip="Open the page that resolves the conflicts"
                    AutomationProperties.Name="Resolve the conflicts">
              <TextBlock Text="Resolve conflicts" FontSize="12" />
            </Button>

            <Button Classes="toolbar"
                    Command="{Binding AbortMergeCommand}"
                    ToolTip.Tip="Put the repository back as it was before the merge"
                    AutomationProperties.Name="Abandon the merge">
              <TextBlock Text="Abandon the merge" FontSize="12" />
            </Button>

            <!-- Enabled only once every conflict is resolved, which is what makes the count above
                 it worth reading. -->
            <Button Classes="accent"
                    Command="{Binding Conflicts.CommitMergeCommand}"
                    ToolTip.Tip="Record the merge commit"
                    AutomationProperties.Name="Commit the merge">
              <TextBlock Text="Commit the merge" FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- git signed in on its own because an integration's stored token could not be read: said once,
           with the way out, rather than leaving git's own prompt unexplained (BUG-3024). -->
      <Border Name="SignInNoticeBand"
              DockPanel.Dock="Top"
              Background="{DynamicResource EnigmaWarningBackgroundBrush}"
              BorderBrush="{DynamicResource EnigmaWarningBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,8"
              IsVisible="{Binding SignInNotice.IsVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <ei:Icon Grid.Column="0" Kind="Key" Classes="row" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaWarningBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{Binding SignInNotice.Message}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Classes="toolbar"
                    Command="{Binding SignInNotice.ResetCommand}"
                    IsVisible="{Binding SignInNotice.OffersReset}"
                    ToolTip.Tip="Delete every stored token, so each integration can be given its token again"
                    AutomationProperties.Name="Reset stored tokens">
              <TextBlock Text="Reset stored tokens" FontSize="12" />
            </Button>
            <Button Classes="toolbar"
                    Command="{Binding SignInNotice.OpenProfilesCommand}"
                    ToolTip.Tip="Open the Profiles page, where an integration's token is replaced"
                    AutomationProperties.Name="Open the Profiles page">
              <TextBlock Text="Open Profiles" FontSize="12" />
            </Button>
            <Button Classes="toolbar"
                    Command="{Binding SignInNotice.DismissCommand}"
                    ToolTip.Tip="Put this notice away for the rest of the session"
                    AutomationProperties.Name="Dismiss the notice">
              <ei:Icon Kind="X" Classes="toolbar" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <nav:NavigationView x:Name="NavigationRail"
                          DockPanel.Dock="Left"
                          Items="{Binding Navigation.Items}"
                          FooterItems="{Binding Navigation.FooterItems}"
                          SelectedItem="{Binding Navigation.SelectedItem, Mode=TwoWay}"
                          Orientation="Vertical"
                          PaneSize="{StaticResource RepositoryRailWidth}" />

      <ContentControl Content="{Binding Navigation.CurrentPage}" />
    </DockPanel>

    <!--
      The tool dialogs — branches, tags, remotes — on a host of their own, under the three overlay
      hosts: the confirmations their operations ask for are shown on HostDialog, above them, and the
      tool dialog is still there when the question has been answered. Sized from the window in
      code-behind, because a list needs a bounded height to scroll in.

      On the library's secondary dialog surface rather than its default one: these are the
      window's pages, laid out for the window's background, with lighter strips — their headers,
      the merge band, the group headings — standing out from it, and the secondary class paints the
      card in that darker tone (EnigmaDialogSecondaryBackgroundBrush), following a theme switch.
      The class is set on this host alone, so the questions asked on HostDialog keep the default
      surface.
    -->
    <contentDialog:ContentDialog x:Name="ToolDialog"
                                 Classes="secondary"
                                 DialogMinWidth="640"
                                 DialogMaxWidth="1100" />

    <!-- The three overlay hosts must be the last children of the root panel. At most 640 high, as
         Enigma.MarkdownEditor's: the About dialog's icon, build and credits fit without scrolling.
         The info bar sits in the bottom-left corner, right of the rail; its width and its offset are
         set from the window in code-behind (InfoBarPlacement). -->
    <contentDialog:ContentDialog x:Name="HostDialog"
                                 DialogMinWidth="380"
                                 DialogMaxWidth="720"
                                 DialogMaxHeight="640" />
    <controls:Overlay x:Name="HostOverlay" />
    <infoBar:InfoBar x:Name="HostInfoBar"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom" />
  </Panel>
</Window>
