<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe suppresses the console window on Windows; on Linux it behaves like Exe. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Enigma.GitClient.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows-only: gives the .exe its icon in Explorer and the taskbar. The running
         window's icon is set separately on MainWindow, which is what Linux uses. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Enigma.Avalonia.Desktop" />
    <PackageReference Include="Enigma.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Enigma.GitClient.Core/Enigma.GitClient.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <!-- The app's entry point and composition root stay internal; the unit-test project drives them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Enigma.GitClient.App.UnitTests" />
  </ItemGroup>
</Project>
