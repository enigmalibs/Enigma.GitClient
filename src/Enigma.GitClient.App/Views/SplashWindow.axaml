<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:product="using:Enigma.GitClient.Core.Diagnostics"
        x:Class="Enigma.GitClient.App.Views.SplashWindow"
        Title="{x:Static product:ProductInformation.DisplayName}"
        Width="420" Height="260"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource EnigmaSurfaceBrush}">

  <!-- Enigma.MarkdownEditor's splash, at the same size and in the same style.

       No x:DataType and no DataContext: what it shows is fixed for the life of the process, so it is
       read straight off ProductInformation with x:Static rather than through a ViewModel that would
       exist to forward two constants.

       TransparencyLevelHint is deliberately left alone. A transparent or blurred splash behaves
       differently on every Linux compositor, and this window's whole job is to look the same
       everywhere. -->

  <Border BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}" BorderThickness="1">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">

      <!-- The PNG rather than app.ico: which frame Skia picks out of an icon is unspecified, and the
           256-pixel one is the only frame worth showing at this size. -->
      <Image x:Name="AppIcon"
             Source="/Assets/app-256.png"
             Width="96"
             Height="96"
             HorizontalAlignment="Center" />

      <TextBlock x:Name="ProductName"
                 Text="{x:Static product:ProductInformation.DisplayName}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource EnigmaForegroundBrush}" />

      <!-- The version, and nothing else. A progress line would spend its one second flickering
           through stages nobody can read. -->
      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
        <TextBlock Text="Version"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
        <TextBlock x:Name="ProductVersion"
                   Text="{x:Static product:ProductInformation.Version}"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
