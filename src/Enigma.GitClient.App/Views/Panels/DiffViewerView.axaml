<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.App.Controls"
             xmlns:diff="using:Enigma.GitClient.App.Controls.Diff"
             xmlns:vm="using:Enigma.GitClient.App.ViewModels.Panels"
             x:Class="Enigma.GitClient.App.Views.Panels.DiffViewerView"
             x:DataType="vm:DiffViewerViewModel">

  <UserControl.Resources>

    <!-- The unified rendering: both line numbers, one marker, one text column. -->
    <DataTemplate x:Key="UnifiedRow" x:DataType="vm:DiffRowViewModel">
      <Panel>

        <Button Classes="band"
                IsVisible="{Binding IsHunkHeader}"
                Command="{Binding ExpandContextCommand}"
                ToolTip.Tip="Show more of the file around this change"
                AutomationProperties.Name="Show more of the file around this change">
          <Border Classes="diffband">
            <TextBlock Text="{Binding HeaderText}" TextTrimming="CharacterEllipsis" />
          </Border>
        </Button>

        <Border Classes="diffrow"
                Classes.added="{Binding Single.IsAdded}"
                Classes.removed="{Binding Single.IsRemoved}"
                IsVisible="{Binding IsLine}"
                ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*">

            <Border Grid.Column="0" Grid.ColumnSpan="2" Classes="diffgutter" />
            <Border Grid.Column="0" Classes="diffselection" />

            <TextBlock Grid.Column="0" Classes="diffnumber" Text="{Binding Single.OldNumber}" />
            <TextBlock Grid.Column="1" Classes="diffnumber" Text="{Binding Single.NewNumber}" />

            <TextBlock Grid.Column="2"
                       Classes="diffmarker"
                       Classes.added="{Binding Single.IsAdded}"
                       Classes.removed="{Binding Single.IsRemoved}"
                       Text="{Binding Single.Marker}" />

            <diff:DiffLineText Grid.Column="3"
                               Classes.added="{Binding Single.IsAdded}"
                               Classes.removed="{Binding Single.IsRemoved}"
                               Text="{Binding Single.Text}"
                               Segments="{Binding Single.Segments}"
                               ShowWhitespace="{Binding Options.ShowWhitespace}"
                               WrapLines="{Binding Options.WrapLines}"
                               TabWidth="{Binding Options.TabWidth}"
                               HorizontalOffset="{Binding Options.UnifiedScroll.Offset}" />
          </Grid>
        </Border>
      </Panel>
    </DataTemplate>

    <!-- The side-by-side rendering: the old file on the left, the new one on the right, kept in
         step by the filler rows the projection inserted. -->
    <DataTemplate x:Key="SideBySideRow" x:DataType="vm:DiffRowViewModel">
      <Panel>

        <Button Classes="band"
                IsVisible="{Binding IsHunkHeader}"
                Command="{Binding ExpandContextCommand}"
                ToolTip.Tip="Show more of the file around this change"
                AutomationProperties.Name="Show more of the file around this change">
          <Border Classes="diffband">
            <TextBlock Text="{Binding HeaderText}" TextTrimming="CharacterEllipsis" />
          </Border>
        </Button>

        <Grid ColumnDefinitions="*,1,*" IsVisible="{Binding IsLine}">

          <!-- ClipToBounds is the fix for the overlap this item is named after: a line wider than
               its pane used to be drawn straight across the divider and over the other side. -->
          <Border Grid.Column="0"
                  Classes="diffrow"
                  Classes.removed="{Binding Left.IsRemoved}"
                  Classes.filler="{Binding Left.IsFiller}"
                  ClipToBounds="True">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Border Grid.Column="0" Classes="diffgutter" />
              <Border Grid.Column="0" Classes="diffselection" />
              <TextBlock Grid.Column="0" Classes="diffnumber" Text="{Binding Left.OldNumber}" />
              <TextBlock Grid.Column="1"
                         Classes="diffmarker"
                         Classes.removed="{Binding Left.IsRemoved}"
                         Text="{Binding Left.Marker}" />
              <diff:DiffLineText Grid.Column="2"
                                 Classes.removed="{Binding Left.IsRemoved}"
                                 Text="{Binding Left.Text}"
                                 Segments="{Binding Left.Segments}"
                                 ShowWhitespace="{Binding Options.ShowWhitespace}"
                                 WrapLines="{Binding Options.WrapLines}"
                                 TabWidth="{Binding Options.TabWidth}"
                                 HorizontalOffset="{Binding Options.SideBySideScroll.Offset}" />
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource EnigmaBorderSubtleBrush}" />

          <Border Grid.Column="2"
                  Classes="diffrow"
                  Classes.added="{Binding Right.IsAdded}"
                  Classes.filler="{Binding Right.IsFiller}"
                  ClipToBounds="True">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Border Grid.Column="0" Classes="diffgutter" />
              <TextBlock Grid.Column="0" Classes="diffnumber" Text="{Binding Right.NewNumber}" />
              <TextBlock Grid.Column="1"
                         Classes="diffmarker"
                         Classes.added="{Binding Right.IsAdded}"
                         Text="{Binding Right.Marker}" />
              <diff:DiffLineText Grid.Column="2"
                                 Classes.added="{Binding Right.IsAdded}"
                                 Text="{Binding Right.Text}"
                                 Segments="{Binding Right.Segments}"
                                 ShowWhitespace="{Binding Options.ShowWhitespace}"
                                 WrapLines="{Binding Options.WrapLines}"
                                 TabWidth="{Binding Options.TabWidth}"
                                 HorizontalOffset="{Binding Options.SideBySideScroll.Offset}" />
            </Grid>
          </Border>
        </Grid>
      </Panel>
    </DataTemplate>

  </UserControl.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">

        <TextBlock Grid.Column="0"
                   Text="{Binding Title}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="320"
                   Foreground="{DynamicResource EnigmaForegroundBrush}" />

        <TextBlock Grid.Column="1"
                   Text="{Binding Subtitle}"
                   IsVisible="{Binding HasSubtitle}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="200"
                   Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

        <TextBlock Grid.Column="2"
                   Text="{Binding Summary}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">

          <ToggleButton Classes="segment"
                        IsChecked="{Binding IsUnified, Mode=OneWay}"
                        Command="{Binding ShowUnifiedCommand}"
                        ToolTip.Tip="Unified"
                        AutomationProperties.Name="Unified">
            <ei:Icon Kind="Rows" Classes="toolbar" />
          </ToggleButton>

          <ToggleButton Classes="segment"
                        IsChecked="{Binding IsSideBySide, Mode=OneWay}"
                        Command="{Binding ShowSideBySideCommand}"
                        ToolTip.Tip="Side by side"
                        AutomationProperties.Name="Side by side">
            <ei:Icon Kind="Columns" Classes="toolbar" />
          </ToggleButton>

          <Border Width="1"
                  Margin="4,2"
                  Background="{DynamicResource EnigmaBorderSubtleBrush}" />

          <ToggleButton Classes="segment"
                        IsChecked="{Binding Render.ShowWhitespace, Mode=TwoWay}"
                        ToolTip.Tip="Show spaces and tabs"
                        AutomationProperties.Name="Show spaces and tabs">
            <ei:Icon Kind="DotsSixVertical" Classes="toolbar" />
          </ToggleButton>

          <ToggleButton Classes="segment"
                        IsChecked="{Binding Render.WrapLines, Mode=TwoWay}"
                        ToolTip.Tip="Wrap long lines"
                        AutomationProperties.Name="Wrap long lines">
            <ei:Icon Kind="TextAlignLeft" Classes="toolbar" />
          </ToggleButton>

          <ToggleButton Classes="segment"
                        IsChecked="{Binding IgnoreAllWhitespace, Mode=TwoWay}"
                        ToolTip.Tip="Ignore whitespace changes"
                        AutomationProperties.Name="Ignore whitespace changes">
            <ei:Icon Kind="Eraser" Classes="toolbar" />
          </ToggleButton>

          <Border Width="1"
                  Margin="4,2"
                  Background="{DynamicResource EnigmaBorderSubtleBrush}" />

          <Button Classes="toolbar"
                  Command="{Binding ExpandContextCommand}"
                  ToolTip.Tip="Show more surrounding lines"
                  AutomationProperties.Name="Show more surrounding lines">
            <ei:Icon Kind="ArrowsOutLineVertical" Classes="toolbar" />
          </Button>

          <Button Classes="toolbar"
                  Command="{Binding CopyPatchCommand}"
                  ToolTip.Tip="Copy the whole patch"
                  AutomationProperties.Name="Copy the whole patch">
            <ei:Icon Kind="Copy" Classes="toolbar" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding IsTruncated}"
            Background="{DynamicResource DiffHunkBandBrush}"
            Padding="10,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="This file is very large, so only the first part of its diff was read."
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
        <Button Grid.Column="1"
                Content="Show anyway"
                Command="{Binding ShowAnywayCommand}" />
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="GitDiff"
                           Title="Diff"
                           Message="{Binding Message}"
                           IsVisible="{Binding HasMessage}" />

      <!--
        A rendering is three things in a two-by-two grid: the patch, the map of its changes beside
        it, and the sideways bar under it. The grid rather than a dock, so the map is exactly as
        tall as the list and the bar exactly as wide — the bar's width is what tells the view how
        many characters of a line fit, so a bar running under the map would measure a pane that is
        not there.

        The vertical scrollbar is Hidden rather than Disabled: the map replaces the bar, not the
        scrolling, so the wheel, the keyboard and the selection still move the list.

        The horizontal bar is outside the list on purpose. A ListBox that scrolls horizontally takes
        its line-number gutter with it, and in the side-by-side rendering it would push the
        right-hand pane off screen — which is the one thing that rendering exists to prevent. These
        bars move the text of one pane and leave everything else where it is.
      -->
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" IsVisible="{Binding IsUnified}">

        <ListBox Grid.Row="0"
                 Grid.Column="0"
                 Name="UnifiedList"
                 Classes="diff"
                 ItemsSource="{Binding UnifiedRows}"
                 ItemTemplate="{StaticResource UnifiedRow}"
                 SelectionMode="Multiple"
                 SelectedItems="{Binding Selection}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 AutomationProperties.Name="Unified diff" />

        <diff:DiffMinimap Grid.Row="0"
                          Grid.Column="1"
                          Name="UnifiedMinimap"
                          IsVisible="{Binding HasPatch}"
                          Marks="{Binding UnifiedMap}"
                          RowCount="{Binding UnifiedRows.Count}"
                          AutomationProperties.Name="Where the changes are in this file" />

        <Panel Grid.Row="1"
               Grid.Column="0"
               Background="{DynamicResource EnigmaSurfaceBrush}">
          <Panel IsVisible="{Binding Render.UnifiedScroll.IsScrollable}">
            <ScrollBar x:Name="UnifiedBar"
                       Orientation="Horizontal"
                       Visibility="Visible"
                       Minimum="0"
                       Maximum="{Binding Render.UnifiedScroll.Maximum}"
                       Value="{Binding Render.UnifiedScroll.Offset, Mode=TwoWay}"
                       ViewportSize="{Binding Render.UnifiedScroll.Viewport}"
                       LargeChange="{Binding Render.UnifiedScroll.PageSize}"
                       SmallChange="1"
                       AutomationProperties.Name="Scroll the diff sideways" />
          </Panel>
        </Panel>
      </Grid>

      <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" IsVisible="{Binding IsSideBySide}">

        <ListBox Grid.Row="0"
                 Grid.Column="0"
                 Name="SideBySideList"
                 Classes="diff"
                 ItemsSource="{Binding SideBySideRows}"
                 ItemTemplate="{StaticResource SideBySideRow}"
                 SelectionMode="Multiple"
                 SelectedItems="{Binding Selection}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 AutomationProperties.Name="Side-by-side diff" />

        <diff:DiffMinimap Grid.Row="0"
                          Grid.Column="1"
                          Name="SideBySideMinimap"
                          IsVisible="{Binding HasPatch}"
                          Marks="{Binding SideBySideMap}"
                          RowCount="{Binding SideBySideRows.Count}"
                          AutomationProperties.Name="Where the changes are in this file" />

        <Grid Grid.Row="1"
              Grid.Column="0"
              ColumnDefinitions="*,1,*"
              Background="{DynamicResource EnigmaSurfaceBrush}">

          <!-- Two bars, one state. Each stays under the pane it belongs to, and because they bind
               the same offset they cannot disagree — dragging either moves both sides. -->
          <Panel Grid.Column="0" IsVisible="{Binding Render.SideBySideScroll.IsScrollable}">
            <ScrollBar x:Name="LeftBar"
                       Orientation="Horizontal"
                       Visibility="Visible"
                       Minimum="0"
                       Maximum="{Binding Render.SideBySideScroll.Maximum}"
                       Value="{Binding Render.SideBySideScroll.Offset, Mode=TwoWay}"
                       ViewportSize="{Binding Render.SideBySideScroll.Viewport}"
                       LargeChange="{Binding Render.SideBySideScroll.PageSize}"
                       SmallChange="1"
                       AutomationProperties.Name="Scroll both files sideways" />
          </Panel>

          <Panel Grid.Column="2" IsVisible="{Binding Render.SideBySideScroll.IsScrollable}">
            <ScrollBar x:Name="RightBar"
                       Orientation="Horizontal"
                       Visibility="Visible"
                       Minimum="0"
                       Maximum="{Binding Render.SideBySideScroll.Maximum}"
                       Value="{Binding Render.SideBySideScroll.Offset, Mode=TwoWay}"
                       ViewportSize="{Binding Render.SideBySideScroll.Viewport}"
                       LargeChange="{Binding Render.SideBySideScroll.PageSize}"
                       SmallChange="1"
                       AutomationProperties.Name="Scroll both files sideways" />
          </Panel>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
