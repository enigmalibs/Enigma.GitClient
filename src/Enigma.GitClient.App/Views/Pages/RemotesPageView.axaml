<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.App.Controls"
             xmlns:vm="using:Enigma.GitClient.App.ViewModels.Pages"
             x:Class="Enigma.GitClient.App.Views.Pages.RemotesPageView"
             x:DataType="vm:RemotesPageViewModel">

  <UserControl.Styles>
    <Style Selector="Border.remoterow:pointerover">
      <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <ei:Icon Kind="CloudArrowUp" Size="18" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          <TextBlock Text="{Binding Title}"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </StackPanel>

        <Button Grid.Column="2"
                Classes="toolbar"
                Command="{Binding AddCommand}"
                ToolTip.Tip="Add a remote"
                AutomationProperties.Name="Add a remote">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Plus" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="New remote" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3"
                Classes="toolbar"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh"
                AutomationProperties.Name="Refresh">
          <ei:Icon Kind="ArrowsClockwise" Size="15" />
        </Button>
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="CloudArrowUp"
                           Title="Remotes"
                           Message="{Binding EmptyMessage}"
                           IsVisible="{Binding IsEmpty}"
                           ZIndex="1" />

      <ScrollViewer IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Remotes}" Margin="0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RemoteRowViewModel">
              <Border Classes="remoterow"
                      Background="Transparent"
                      BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="16,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Fetch"
                                Command="{Binding FetchCommand}"
                                CommandParameter="{Binding}" />
                      <Separator />
                      <MenuItem Header="Edit…"
                                Command="{Binding EditCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="Remove…"
                                Command="{Binding RemoveCommand}"
                                CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Grid.ContextMenu>

                  <ei:Icon Grid.Column="0"
                           Kind="HardDrives"
                           Size="16"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

                  <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource EnigmaForegroundBrush}" />
                      <Border Classes="pill"
                              Background="{DynamicResource EnigmaSelectionBrush}"
                              IsVisible="{Binding HasHost}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Host}"
                                   FontSize="10"
                                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                      </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding FetchUrl}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

                    <TextBlock Text="{Binding PushUrl, StringFormat='pushes to {0}'}"
                               IsVisible="{Binding HasSeparatePushUrl}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
                  </StackPanel>

                  <TextBlock Grid.Column="2"
                             Text="{Binding BranchSummary}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="toolbar"
                            Command="{Binding FetchCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Fetch from this remote"
                            AutomationProperties.Name="Fetch from this remote">
                      <ei:Icon Kind="ArrowsDownUp" Size="14" />
                    </Button>
                    <Button Classes="toolbar"
                            Command="{Binding EditCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Edit"
                            AutomationProperties.Name="Edit this remote">
                      <ei:Icon Kind="PencilSimple" Size="14" />
                    </Button>
                    <Button Classes="toolbar"
                            Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Remove"
                            AutomationProperties.Name="Remove this remote">
                      <ei:Icon Kind="Trash" Size="14" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
