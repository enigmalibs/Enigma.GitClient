<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.App.Controls"
             xmlns:vm="using:Enigma.GitClient.App.ViewModels.Pages"
             x:Class="Enigma.GitClient.App.Views.Pages.RemotesPageView"
             x:DataType="vm:RemotesPageViewModel">

  <UserControl.Styles>
    <!-- A row fills its container and brings its own separator line; the hover and the selection
         are the list's, as they are on every other list in the application. -->
    <Style Selector="ListBox > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <ei:Icon Kind="CloudArrowUp" Classes="header" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          <TextBlock Text="{Binding Title}"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </StackPanel>

        <Button Grid.Column="2"
                Classes="toolbar"
                Command="{Binding AddCommand}"
                ToolTip.Tip="Add a remote"
                AutomationProperties.Name="Add a remote">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="New remote" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3"
                Classes="toolbar"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh"
                AutomationProperties.Name="Refresh">
          <ei:Icon Kind="ArrowsClockwise" Classes="toolbar" />
        </Button>
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="CloudArrowUp"
                           Title="Remotes"
                           Message="{Binding EmptyMessage}"
                           IsVisible="{Binding IsEmpty}"
                           ZIndex="1" />

      <ListBox Name="RemoteList"
               IsVisible="{Binding !IsEmpty}"
               ItemsSource="{Binding Remotes}"
               SelectedItem="{Binding SelectedRemote, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0,4"
               AutomationProperties.Name="Remotes">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RemoteRowViewModel">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Fetch"
                              Command="{Binding FetchCommand}"
                              CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Edit…"
                              Command="{Binding EditCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="Remove…"
                              Command="{Binding RemoveCommand}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </Grid.ContextMenu>

                <ei:Icon Grid.Column="0"
                         Kind="HardDrives"
                         Classes="row"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

                <StackPanel Grid.Column="1" Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource EnigmaForegroundBrush}" />
                    <Border Classes="pill"
                            Background="{DynamicResource EnigmaSelectionBrush}"
                            IsVisible="{Binding HasHost}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Host}"
                                 FontSize="10"
                                 Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                    </Border>
                  </StackPanel>

                  <TextBlock Text="{Binding FetchUrl}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

                  <TextBlock Text="{Binding PushUrl, StringFormat='pushes to {0}'}"
                             IsVisible="{Binding HasSeparatePushUrl}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding BranchSummary}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Classes="toolbar"
                          Command="{Binding FetchCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Fetch from this remote"
                          AutomationProperties.Name="Fetch from this remote">
                    <ei:Icon Kind="ArrowsDownUp" Classes="row" />
                  </Button>
                  <Button Classes="toolbar"
                          Command="{Binding EditCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Edit"
                          AutomationProperties.Name="Edit this remote">
                    <ei:Icon Kind="PencilSimple" Classes="row" />
                  </Button>
                  <Button Classes="toolbar"
                          Command="{Binding RemoveCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Remove"
                          AutomationProperties.Name="Remove this remote">
                    <ei:Icon Kind="Trash" Classes="row" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
