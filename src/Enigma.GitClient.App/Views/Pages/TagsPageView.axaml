<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:controls="using:Enigma.GitClient.App.Controls"
             xmlns:vm="using:Enigma.GitClient.App.ViewModels.Pages"
             x:Class="Enigma.GitClient.App.Views.Pages.TagsPageView"
             x:DataType="vm:TagsPageViewModel">

  <!--
    The tags page. Deliberately the branches page's twin — the same header, the same row, the same
    empty state — because the two lists are the same kind of thing and used to be one page behind a
    switch. What it does not share is the branches page's drag gesture: dropping one reference onto
    another means a merge, and a tag is not something to merge.
  -->

  <UserControl.Styles>
    <!--
      A row fills its container and brings its own separator line; the hover and the selection are
      the list's, so a selected tag looks selected the way every other list in the application does.
    -->
    <Style Selector="ListBox > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{DynamicResource EnigmaSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <ei:Icon Kind="Tag" Classes="header" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
          <TextBlock Text="{Binding Title}"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </StackPanel>

        <TextBox Grid.Column="1"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 MaxWidth="320"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 AutomationProperties.Name="Filter tags" />

        <Button Grid.Column="2"
                Classes="toolbar"
                Command="{Binding CreateCommand}"
                ToolTip.Tip="Create a tag"
                AutomationProperties.Name="Create a tag">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ei:Icon Kind="Plus" Classes="toolbar" VerticalAlignment="Center" />
            <TextBlock Text="New tag" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3"
                Classes="toolbar"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh"
                AutomationProperties.Name="Refresh">
          <ei:Icon Kind="ArrowsClockwise" Classes="toolbar" />
        </Button>
      </Grid>
    </Border>

    <Grid>

      <controls:EmptyState IconKind="Tag"
                           Title="Tags"
                           Message="{Binding EmptyMessage}"
                           IsVisible="{Binding IsEmpty}"
                           ZIndex="1" />

      <ListBox Name="TagList"
               ItemsSource="{Binding Tags}"
               SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0,4"
               AutomationProperties.Name="Tags">

        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TagRowViewModel">
            <Border Classes="branchrow"
                    Background="Transparent"
                    BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,7">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">

                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Check out (detaches HEAD)"
                              Command="{Binding CheckoutCommand}"
                              CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Delete…"
                              Command="{Binding DeleteCommand}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </Grid.ContextMenu>

                <ei:Icon Grid.Column="0"
                         Kind="Tag"
                         Classes="row dim"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource EnigmaForegroundBrush}" />
                    <Border Classes="pill" VerticalAlignment="Center">
                      <TextBlock Classes="dim" Text="{Binding Kind}" FontSize="10" />
                    </Border>
                  </StackPanel>

                  <TextBlock Text="{Binding Message}"
                             IsVisible="{Binding HasMessage}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             Classes="dim" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Classes="monospace faint"
                           Text="{Binding ShortSha}"
                           VerticalAlignment="Center"
                           FontSize="11" />

                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Tagger}"
                             IsVisible="{Binding HasTagger}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="160"
                             HorizontalAlignment="Right"
                             Classes="faint" />
                  <TextBlock Text="{Binding Date}"
                             FontSize="11"
                             HorizontalAlignment="Right"
                             Classes="faint" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Classes="toolbar"
                          Command="{Binding CheckoutCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Check out (detaches HEAD)"
                          AutomationProperties.Name="Check out this tag">
                    <ei:Icon Kind="SignIn" Classes="row" />
                  </Button>
                  <Button Classes="toolbar"
                          Command="{Binding DeleteCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Delete"
                          AutomationProperties.Name="Delete tag">
                    <ei:Icon Kind="Trash" Classes="row" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
