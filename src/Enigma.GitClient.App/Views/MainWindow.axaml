<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ei="https://github.com/josueclement/Enigma.Icons"
        xmlns:vm="using:Enigma.GitClient.App.ViewModels"
        xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
        xmlns:contentDialog="using:Enigma.Avalonia.Desktop.Controls.ContentDialog"
        xmlns:infoBar="using:Enigma.Avalonia.Desktop.Controls.InfoBar"
        xmlns:nav="using:Enigma.Avalonia.Desktop.Controls.Navigation"
        x:Class="Enigma.GitClient.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="560"
        Background="{DynamicResource EnigmaBackgroundBrush}">

  <Panel>
    <DockPanel>

      <!-- Repository strip: which repository is open, where HEAD is, and what is in progress. -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource EnigmaSurfaceBrush}"
              BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,8">
        <Grid ColumnDefinitions="Auto,*,Auto">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <ei:Icon Kind="Folder" Size="16" VerticalAlignment="Center"
                     Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
            <TextBlock Text="{Binding RepositoryName}"
                       ToolTip.Tip="{Binding RepositoryPath}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource EnigmaForegroundBrush}" />

            <Border Classes="pill"
                    Background="{DynamicResource EnigmaSelectionBrush}"
                    IsVisible="{Binding RepositoryContext.IsRepositoryOpen}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ei:Icon Kind="GitBranch" Size="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />
                <TextBlock Text="{Binding HeadDisplayName}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource EnigmaForegroundBrush}" />
              </StackPanel>
            </Border>

            <Border Classes="pill"
                    Background="{DynamicResource EnigmaWarningBackgroundBrush}"
                    BorderBrush="{DynamicResource EnigmaWarningBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding IsHeadDetached}">
              <TextBlock Text="detached HEAD"
                         FontSize="12"
                         Foreground="{DynamicResource EnigmaForegroundBrush}" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <Button Classes="toolbar"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Refresh the repository state"
                    AutomationProperties.Name="Refresh the repository state">
              <ei:Icon Kind="ArrowsClockwise" Size="16" />
            </Button>
            <Button Classes="toolbar"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip.Tip="Switch between the dark and light themes"
                    AutomationProperties.Name="Switch between the dark and light themes">
              <ei:Icon Kind="Palette" Size="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Operation banner: shown only while the repository is mid-merge, mid-revert and so on. -->
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource EnigmaWarningBackgroundBrush}"
              BorderBrush="{DynamicResource EnigmaWarningBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,8"
              IsVisible="{Binding HasOperationInProgress}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ei:Icon Kind="Warning" Size="16" VerticalAlignment="Center"
                   Foreground="{DynamicResource EnigmaWarningBrush}" />
          <TextBlock Text="{Binding OperationDescription}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </StackPanel>
      </Border>

      <nav:NavigationView DockPanel.Dock="Left"
                          Items="{Binding Navigation.Items}"
                          FooterItems="{Binding Navigation.FooterItems}"
                          SelectedItem="{Binding Navigation.SelectedItem, Mode=TwoWay}"
                          Orientation="Vertical"
                          PaneSize="96" />

      <ContentControl Content="{Binding Navigation.CurrentPage}" />
    </DockPanel>

    <!-- The three overlay hosts must be the last children of the root panel. -->
    <contentDialog:ContentDialog x:Name="HostDialog"
                                 DialogMinWidth="380"
                                 DialogMaxWidth="720"
                                 DialogMaxHeight="600" />
    <controls:Overlay x:Name="HostOverlay" />
    <infoBar:InfoBar x:Name="HostInfoBar" />
  </Panel>
</Window>
